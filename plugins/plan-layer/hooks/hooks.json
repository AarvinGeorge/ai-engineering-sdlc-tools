{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brief.py\" --session-start 2>/dev/null || true",
            "shell": "bash",
            "timeout": 10,
            "async": false,
            "statusMessage": "Reading plan state"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/brief.py\" --pre-compact 2>/dev/null || true",
            "shell": "bash",
            "timeout": 10,
            "async": false,
            "statusMessage": "Flushing plan state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/gate_hook.py\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 15,
            "async": false,
            "statusMessage": "Checking the plan"
          }
        ]
      }
    ]
  }
}
